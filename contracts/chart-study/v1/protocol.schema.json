{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chartly chart study process protocol v1",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/result" },
    { "$ref": "#/$defs/failure" }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}(?![\\s\\S])" },
    "time": { "type": "integer", "minimum": 0, "maximum": 253402300799 },
    "number": { "type": "number", "minimum": -1000000000000, "maximum": 1000000000000 },
    "candle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "open", "high", "low", "close", "volume"],
      "properties": {
        "time": { "$ref": "#/$defs/time" },
        "open": { "$ref": "#/$defs/number" },
        "high": { "$ref": "#/$defs/number" },
        "low": { "$ref": "#/$defs/number" },
        "close": { "$ref": "#/$defs/number" },
        "volume": { "type": "number", "minimum": 0, "maximum": 1000000000000 }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "id", "method", "study", "parameters", "candles"],
      "properties": {
        "version": { "const": 1 },
        "id": { "$ref": "#/$defs/id" },
        "method": { "const": "study.evaluate" },
        "study": { "$ref": "#/$defs/id" },
        "parameters": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": {
            "anyOf": [
              { "$ref": "#/$defs/number" },
              { "type": "boolean" }
            ]
          }
        },
        "candles": {
          "type": "array", "minItems": 1, "maxItems": 4096,
          "items": { "$ref": "#/$defs/candle" }
        }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "value"],
      "properties": {
        "time": { "$ref": "#/$defs/time" },
        "value": { "anyOf": [{ "$ref": "#/$defs/number" }, { "type": "null" }] }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "id", "series"],
      "properties": {
        "version": { "const": 1 },
        "id": { "$ref": "#/$defs/id" },
        "series": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "points"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "points": {
                "type": "array", "minItems": 1, "maxItems": 4096,
                "items": { "$ref": "#/$defs/point" }
              }
            }
          }
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "id", "error"],
      "properties": {
        "version": { "const": 1 },
        "id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code"],
          "properties": {
            "code": {
              "enum": [
                "request.too_large", "request.invalid_json", "request.invalid",
                "request.unsupported_version", "study.unsupported",
                "study.invalid_parameters", "study.invalid_candles"
              ]
            }
          }
        }
      }
    }
  }
}
